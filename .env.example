# TikunCRM Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Database Configuration
# ===========================================
POSTGRES_USER=tikuncrm
POSTGRES_PASSWORD=change_this_to_a_secure_password
POSTGRES_DB=tikuncrm
DATABASE_URL=postgresql+asyncpg://tikuncrm:change_this_to_a_secure_password@db:5432/tikuncrm

# ===========================================
# Redis Configuration
# ===========================================
REDIS_URL=redis://redis:6379

# ===========================================
# Security
# ===========================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your_secret_key_here

# ===========================================
# CORS Configuration
# ===========================================
CORS_ORIGINS=https://tikuncrm.com,https://www.tikuncrm.com

# ===========================================
# Frontend URLs (used during build)
# ===========================================
NEXT_PUBLIC_API_URL=https://api.tikuncrm.com/api/v1
NEXT_PUBLIC_WS_URL=wss://api.tikuncrm.com
NEXT_PUBLIC_APP_URL=https://tikuncrm.com

# ===========================================
# Twilio Configuration (SMS/Calls)
# ===========================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ===========================================
# SendGrid Configuration (Email)
# ===========================================
SENDGRID_API_KEY=

# ===========================================
# Firebase Configuration (Push Notifications)
# ===========================================
# Paste your Firebase service account JSON as a single line
FIREBASE_CREDENTIALS=

# ===========================================
# AWS S3 Configuration (File Uploads)
# ===========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=tikuncrm-uploads

# ===========================================
# Azure Blob Storage (stips, recordings, WhatsApp media)
# ===========================================
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=call-recordings
AZURE_STORAGE_CONTAINER_STIPS=lead-stips
AZURE_STORAGE_CONTAINER_WHATSAPP=whatsapp-media

# ===========================================
# WhatsApp Business API (optional)
# ===========================================
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ===========================================
# AI Call Reviews (transcription + AI scoring of recorded calls)
# ===========================================
# Needs DEEPGRAM_API_KEY (transcription) and OPENAI_API_KEY (scoring).
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
# Automatically review every eligible recorded call. Leave false until call-recording
# consent/disclosure has been confirmed: turning it on sends call audio to Deepgram
# and transcripts to OpenAI. Managers can review individual calls on demand either way.
CALL_REVIEW_AUTO_ENABLED=false
CALL_REVIEW_MODEL=gpt-4o
CALL_REVIEW_MIN_DURATION_SECONDS=30
# Email a weekly call report to all active managers (Mondays 13:00 UTC). Needs the SMTP settings.
CALL_REVIEW_WEEKLY_REPORT_ENABLED=false
