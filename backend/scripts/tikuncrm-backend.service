[Unit]
Description=TikunCRM Backend (FastAPI + APScheduler)
After=network.target

[Service]
Type=simple
User=tikuncrm
Group=tikuncrm
WorkingDirectory=/home/tikuncrm/TikunCRM/backend
EnvironmentFile=-/home/tikuncrm/TikunCRM/backend/.env
Environment=BACKGROUND_SCHEDULER_ENABLED=true
Environment=APP_ENV=production
ExecStart=/home/tikuncrm/TikunCRM/backend/scripts/start_prod.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
