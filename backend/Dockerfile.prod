FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 appuser

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY --chown=appuser:appuser . .

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 8000

# Single worker required: APScheduler (Google Sheets sync, email sync, reminders)
# runs in-process and only one worker can hold /tmp/tikuncrm_scheduler.lock.
# Multi-worker without failover leaves auto-sync dead if the leader exits.
# Scale horizontally with multiple containers + external lock, or use start_prod.sh.
ENV APP_ENV=production
ENV BACKGROUND_SCHEDULER_ENABLED=true
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
